# Copy to .env. Keep real credentials out of git.
# Auth and MongoDB are configured in next-app/.env.local.
PORT=5000
NODE_ENV=development

POLLING_ENABLED=true
# Minutes between polls (1-1440):
POLL_INTERVAL_MINUTES=5

REDIS_HOST=localhost
REDIS_PORT=6379
# Match root .env for Docker Redis. Required for production.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD

JOLPICA_API=https://api.jolpi.ca/ergast/f1
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email and push delivery are not connected; no email credentials are needed.
