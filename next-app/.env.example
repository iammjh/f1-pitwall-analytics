# Copy to .env.local. Keep real credentials out of git.
# npm run db:push and db:studio load the same env files as Next.js.

# Local Docker: match root .env's MONGO_ROOT_USER and MONGO_ROOT_PASSWORD.
# Run docker compose run --rm mongodb-init before using Prisma.
MONGODB_URI=mongodb://f1admin:REPLACE_WITH_RANDOM_MONGO_PASSWORD@localhost:27017/f1-analytics?authSource=admin&replicaSet=rs0&directConnection=true
# Alternatively, use your Atlas replica-set connection URI:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/f1-analytics

# Match root .env's REDIS_PASSWORD. Percent-encode special URI characters.
REDIS_URL=redis://:REPLACE_WITH_RANDOM_REDIS_PASSWORD@localhost:6379

# Generate independently: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_OUTPUT
NEXTAUTH_URL=http://localhost:3000

# Optional Bull database sync jobs; distinct from Express cache polling.
BACKGROUND_JOBS_ENABLED=false

# AI race recaps use Groq's free tier (https://console.groq.com). Leave empty to keep recaps disabled.
GROQ_API_KEY=

# Race-start alerts and password recovery. Leave SMTP_HOST empty to disable email.
# CRON_SECRET authorizes scheduled /api/notifications/race-alerts (15 min) and
# /api/auth/password-reset/deliver (every minute). Vercel Cron sends it automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CRON_SECRET=
# Browser push alerts (VAPID). Generate once with: npx web-push generate-vapid-keys
# The public key is shipped to browsers; keep VAPID_PRIVATE_KEY secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pitwall-analytics.vercel.app

# Optional OAuth; leave empty until providers are configured.
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENF1_API=https://api.openf1.org/v1
# Optional paid OpenF1 live access. Server-only: never use NEXT_PUBLIC_ names.
# Leave both empty for free historical access. Tokens refresh automatically.
OPENF1_USERNAME=
OPENF1_PASSWORD=
ERGAST_API=https://api.jolpi.ca/ergast/f1
